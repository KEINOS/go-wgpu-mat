+// bindBufferSizes binds naga's implicit _mslBufferSizes argument for kernels
+// that reference runtime-sized arrays (WGSL arrayLength and naga's storage
+// bounds checks). The translated MSL kernel takes an extra
+// `constant _mslBufferSizes&` parameter — one uint32 byte-size per
+// runtime-sized-array global, in IR declaration order — with no explicit
+// [[buffer(N)]] attribute, so Metal assigns it the buffer index directly
+// after the declared buffer bindings (bufferSlotMax).
+//
+// Binding this is mandatory: left unbound, the kernel reads a garbage sizes
+// struct, arrayLength() returns a huge value, the thread bounds guard stops
+// working, and the kernel reads/writes past the end of its buffers. On Apple
+// Silicon the Metal driver suballocates small Shared buffers into 256-byte
+// slots, so such out-of-bounds writes corrupt neighbouring buffers.
+func (e *ComputePassEncoder) bindBufferSizes() {
+	p := e.pipeline
+	if p == nil || len(p.sizesBindings) == 0 {
+		return
+	}
+	sizes := make([]uint32, len(p.sizesBindings))
+	for i, rb := range p.sizesBindings {
+		sizes[i] = uint32(e.bindingSizes[[2]uint32{rb.Group, rb.Binding}])
+	}
+	_ = MsgSend(e.raw, Sel("setBytes:length:atIndex:"),
+		uintptr(unsafe.Pointer(&sizes[0])), uintptr(4*len(sizes)), uintptr(e.bufferSlotMax))
+}
