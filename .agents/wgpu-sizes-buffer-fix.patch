+// runtimeArrayBindings returns the resource bindings of global variables whose
+// type contains a runtime-sized array, in IR global declaration order.
+//
+// This mirrors naga's MSL codegen (scanBufferSizeGlobals): the generated
+// _mslBufferSizes struct has one uint32 field per such global in this exact
+// order, and each field must carry the bound buffer's byte size. Without this
+// the MSL kernel reads an unbound sizes argument, producing a garbage
+// arrayLength() and out-of-bounds storage writes.
+func runtimeArrayBindings(module *ir.Module) []ir.ResourceBinding {
+	if module == nil {
+		return nil
+	}
+	var out []ir.ResourceBinding
+	for _, global := range module.GlobalVariables {
+		if global.Binding == nil {
+			continue
+		}
+		if typeNeedsArrayLength(module, global.Type) {
+			out = append(out, *global.Binding)
+		}
+	}
+	return out
+}
+
+// typeNeedsArrayLength reports whether the given type is or contains (as its
+// last struct member) a runtime-sized array, matching naga's needsArrayLength.
+func typeNeedsArrayLength(module *ir.Module, handle ir.TypeHandle) bool {
+	if int(handle) >= len(module.Types) {
+		return false
+	}
+	switch inner := module.Types[handle].Inner.(type) {
+	case ir.ArrayType:
+		return inner.Size.Constant == nil // runtime-sized array
+	case ir.StructType:
+		if len(inner.Members) == 0 {
+			return false
+		}
+		return typeNeedsArrayLength(module, inner.Members[len(inner.Members)-1].Type)
+	default:
+		return false
+	}
+}
